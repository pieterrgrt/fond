# Kopieer naar .env en vul in. .env staat niet in git.
# Maak de hash en sleutel met:  docker compose run --rm fond fond hash-wachtwoord
# (of lokaal: uv run fond hash-wachtwoord).
FOND_PASSWORD_HASH=
FOND_SECRET_KEY=
# Widget op je telefoon (Scriptable): GET /api/widget met  Authorization: Bearer <deze waarde>.
# Leeg = uit. Maak er een met:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOND_WIDGET_TOKEN=
