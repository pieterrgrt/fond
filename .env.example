# Kopieer naar .env en vul in. .env staat niet in git.
# Maak de sleutel met:  docker compose run --rm fond fond sleutel
# (of lokaal: uv run fond sleutel).
FOND_SECRET_KEY=
# Mag iedereen zelf een account maken? false = aanmelden gesloten.
FOND_REGISTRATIE=true
# Alleen voor een Fond van vóór de accounts: het oude wachtwoord (hash) wordt dat van
# het account "eigenaar". Na het overzetten mag deze regel weg.
FOND_PASSWORD_HASH=
# Oude, vaste widgetsleutel (geeft het eerste account). Nieuwe sleutels maak je per
# account op /account. Leeg = uit.
FOND_WIDGET_TOKEN=
