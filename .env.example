# Kopieer naar .env en vul in. .env staat niet in git.
# Maak de hash en sleutel met:  docker compose run --rm fond fond hash-wachtwoord
# (of lokaal: uv run fond hash-wachtwoord). Elk $ in de hash wordt $$ in dit bestand.
FOND_PASSWORD_HASH=
FOND_SECRET_KEY=

# Naam van het Docker-netwerk van je nginx-container (zie `docker network ls`).
PROXY_NETWORK=proxy
